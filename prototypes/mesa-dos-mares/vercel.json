{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "node scripts/vercel-build.js",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/saude", "destination": "/api/saude" },
    { "source": "/narrar", "destination": "/api/narrar" },
    { "source": "/ficha", "destination": "/api/ficha" },
    { "source": "/abertura", "destination": "/api/abertura" },
    { "source": "/chave", "destination": "/api/chave" },
    { "source": "/teste", "destination": "/api/chave" },
    { "source": "/modelos", "destination": "/api/chave" }
  ],
  "functions": {
    "api/narrar.js": { "maxDuration": 60 },
    "api/ficha.js": { "maxDuration": 30 },
    "api/abertura.js": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
